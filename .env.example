# Google AI Studio: https://aistudio.google.com/api-keys
GOOGLE_API_KEY=your_google_ai_studio_key_here
# gemini-3.5-flash-lite is the current low-cost/free-tier default.
# Use gemini-3.8-flash if you want stronger extraction accuracy.
GEMINI_MODEL=gemini-3.5-flash-lite

# WhatsApp Cloud API (https://developers.facebook.com/apps)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# Optional but recommended: enables X-Hub-Signature-256 verification.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Excel output (local path; docker-compose overrides this to /app/data/facturas.xlsx)
EXCEL_PATH=./data/facturas.xlsx
EXCEL_SHEET_NAME=Facturas

# Optional: require X-API-Key for /process and /report. Leave empty to disable.
APP_API_KEY=

LOG_LEVEL=INFO
